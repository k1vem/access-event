# Local development secrets. Replace these values before any public deployment.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRATION_HOURS=24

# Optional: by default the app uses a local SQLite database.
# For local PostgreSQL, set DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/accessevent
